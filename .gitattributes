# 所有文本文件统一由 Git 规范为 LF
* text=auto eol=lf

# ==============================
# 明确的文本文件
# ==============================

*.md     text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.html   text eol=lf
*.svg    text eol=lf

.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf


# ==============================
# 二进制文件
# ==============================

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
